{
  "name": "transferareainterface",
  "version": "1.0.0",
  "type": "module",
  "description": "盘古系统转账区 - 基于 UTXO 模型的区块链支付钱包前端界面与后端核心代码实现。",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "postbuild": "node scripts/copy-sw.js",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:api": "node scripts/check-api-routes.js",
    "test": "node --test tests/interestAccrual.node.test.js tests/txCerLifecycle.node.test.js tests/protocolV2.node.test.js tests/exactAmountPaths.node.test.js tests/serializedMutation.node.test.js tests/losslessTXCerDelivery.node.test.js tests/liabilityAuthoritySnapshot.node.test.js tests/realBrowserFlow.node.test.js",
    "sync:protocol-v2": "node scripts/sync-protocol-v2.js",
    "generate:protocol-v2-client-signature": "node scripts/generate-protocol-v2-client-signature.js",
    "test:real-backend": "node scripts/check-real-backend-protocol.js",
    "test:real-browser": "node scripts/check-real-browser-flow.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/crypto-js": "^4.2.2",
    "@types/elliptic": "^6.4.18",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  },
  "dependencies": {
    "crypto-js": "^4.2.0",
    "elliptic": "^6.6.1",
    "js-sha256": "^0.11.1",
    "json-bigint": "^1.0.0",
    "lit-html": "^3.3.1",
    "marked": "^17.0.1"
  }
}
